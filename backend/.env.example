NODE_ENV=development
PORT=5000

# MongoDB URI (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/customer-reminder
FRONTEND_URL=http://localhost:5173

# Single Owner Authentication
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=admin123
JWT_SECRET=super_secret_dev_jwt_key_remindiq_secure_auth_session
COOKIE_NAME=customer_session

# Timezone (Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Destination Email for Due Reminders
NOTIFICATION_EMAIL=owner@example.com

# SMTP configuration for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Customer Reminder" <reminders@example.com>

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
